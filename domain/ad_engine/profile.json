{
  "schema_version": 1,
  "profile_id": "ad_engine",
  "display_name": "广告引擎",
  "language": "zh-CN",
  "sources": {
    "wiki": {
      "root": "wiki",
      "glob": "**/*.md"
    },
    "code": {
      "roots": [
        "codes"
      ],
      "include_ext": [
        ".py",
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".go",
        ".java",
        ".sql"
      ],
      "exclude_dirs": [
        ".git",
        "__pycache__",
        ".pytest_cache",
        "node_modules",
        ".venv",
        "venv",
        "dist",
        "build",
        "target"
      ]
    }
  },
  "routing": {
    "default_module": "ad-serving-orchestrator"
  },
  "modules": [
    {
      "name": "ad-serving-orchestrator",
      "hint": "广告在线投放编排与请求链路概览",
