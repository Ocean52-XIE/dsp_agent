  "retrieval": {
    "presets": {
      "hybrid": {
        "wiki_top_k": 4,
        "code_top_k": 4,
        "final_top_k": 6
      },
      "wiki_first": {
        "wiki_top_k": 6,
        "code_top_k": 2,
        "final_top_k": 6
      },
      "code_first": {
        "wiki_top_k": 2,
        "code_top_k": 7,
        "final_top_k": 6
      }
    },
    "source_weights": {
      "wiki": 1.0,
      "code": 1.0
    },
    "max_per_source": {
      "wiki": 4,
      "code": 4
    },
    "enable_wiki": true,
    "enable_code": true,
    "embedding": {
      "enabled": true,
      "model": "BAAI/bge-base-zh-v1.5",
      "device": "cpu",
      "top_k": 4,
      "persist_root": ".vectorstore",
      "cache_dir": "C:\\Users\\46685\\.cache\\huggingface\\hub"
    },
    "reranker": {
      "enabled": true,
      "model": "BAAI/bge-reranker-base",
      "device": "cpu",
      "top_k": 4,
      "candidate_top_k": 20,
      "batch_size": 8,
      "max_length": 512,
      "cache_dir": "C:\\Users\\46685\\.cache\\huggingface\\hub"
    },
    "hybrid_weights": {
      "bm25": 0.3,
      "embedding": 0.5,
      "lexical": 0.2
    },
    "module_prior_boost": 0.25
  },
  "fusion": {
    "intent_source_bias": {
      "code_location": {
        "code": 0.25,
        "wiki": -0.1
      },
      "wiki_first": {
        "wiki": 0.15,
        "code": -0.05
      }
    }
  },
  "answering": {
    "calibration_terms": [
      "校准",
      "pctr",
      "pcvr",
      "ctr",
      "cvr"
    ],
    "bid_terms": [
      "target_cpa",
      "target_roas",
      "出价",
      "bid",
      "pcvr"
    ],
    "bid_entry_terms": [
      "入口",
      "函数",
      "实现"
    ],
    "default_entry_symbol": "compute_bid_for_request"
  },
  "prompts": {
    "deep_agent_system_path": "prompts/deep_agent_system.md"
  },
  "deep_agents": {
    "enabled": true,
    "skills_root": "domain/ad_engine/skills",
    "primary_skills": [
      "intent-router",
      "knowledge-qa",
      "issue-analysis"
    ],
    "tools": {
      "domain_retrieve": {
        "default_top_k": 6,
        "max_top_k": 10,
        "default_bias": "hybrid"
      }
    }
  }
}
